# Copy to .env and fill in whichever providers you registered for.
# Default provider used by the UI/CLI (ollama | groq | gemini | openrouter | openai | xai)
SNIPFORGE_PROVIDER=groq

GROQ_API_KEY=            # comma-separate several keys to rotate on rate limits
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Override default models if needed
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash
# OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
# OLLAMA_MODEL=qwen2.5-coder:latest      # run `ollama list` to see exact local tag names

# Optional: dense retrieval with the local embedding SLM (blended with BM25)
# SNIPFORGE_EMBED_MODEL=gte-large

# SNIPFORGE_MAX_REPAIRS=1
# SNIPFORGE_TEST_TIMEOUT=10

# Execution runner: auto (container if snipforge-runner:1 image exists, else isolated process) | docker | process | none
# SNIPFORGE_RUNNER=auto
